<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect external requests with .html extension to clean URL (e.g. /about.html -> /about)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Resolve clean URLs to .html files internally (e.g. /about serves about.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Resolve subfolder clean URLs internally (e.g. /services/dental-implants serves services/dental-implants.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
